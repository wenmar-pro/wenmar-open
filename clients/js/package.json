{
  "name": "wenmar-open",
  "version": "0.2.0",
  "description": "VIN decoding and a year, make, model, trim and engine catalog: a typed client for the Wenmar Open API, and an offline mode that answers from a data file with no network. No API key.",
  "keywords": [
    "vin",
    "vin-decoder",
    "vehicle",
    "automotive",
    "nhtsa",
    "vpic",
    "offline",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Wenmar Pro (https://wenmarpro.com)",
  "homepage": "https://open.wenmarpro.com",
  "bugs": "https://github.com/wenmar-pro/wenmar-open/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenmar-pro/wenmar-open.git",
    "directory": "clients/js"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "default": "./dist/offline/index.js"
    },
    "./offline/node": {
      "types": "./dist/offline/node.d.ts",
      "default": "./dist/offline/node.js"
    },
    "./offline.wasm": "./dist/offline/wenmar_open.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "wenmar-open-data": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "wenmar-open-data": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json && node scripts/build-wasm.mjs",
    "test:types": "node scripts/readme-examples.mjs && tsc -p test/types/tsconfig.dom.json && tsc -p test/types/tsconfig.node.json",
    "test:unit": "node scripts/clean.mjs .test-build && tsc -p tsconfig.test.json && node --test .test-build/*.test.js",
    "test": "npm run build && npm run test:types && npm run test:unit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
