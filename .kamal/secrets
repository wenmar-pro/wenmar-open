# Secrets for config/deploy.yml.
#
# This repository is public. Never write a value in this file: each line
# fetches its secret from Bitwarden Secrets Manager when `kamal deploy` runs.
#
# Before deploying, in the shell that runs kamal:
#
#   export BWS_ACCESS_TOKEN=...   # a machine account's access token
#
# The id below is the secret's id in Bitwarden (`bws secret list`). An id is
# not a secret: it is useless without the access token.

# The token /feedback files GitHub issues with. A fine-grained personal
# access token for wenmar-pro/wenmar-open with only "Issues: read and write".
OPEN_GITHUB_TOKEN=$(bws secret get REPLACE_WITH_BWS_SECRET_ID --output json | jq -r .value)
